# Supabase Project Configuration
# Use the same project in local development and your hosting provider.
SUPABASE_PROJECT_ID="amrzlzjxwonyzuhncdfk"
SUPABASE_URL="https://amrzlzjxwonyzuhncdfk.supabase.co"

# Supabase Client / Public Keys (Anon / Publishable)
# Used by the browser client and authenticated server requests.
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Frontend / Vite Client-Side Environment Variables
VITE_SUPABASE_PROJECT_ID="amrzlzjxwonyzuhncdfk"
VITE_SUPABASE_URL="https://amrzlzjxwonyzuhncdfk.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Same-origin TanStack server routes use Supabase for all database and storage operations.
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Supabase Server / Admin Role Key (Bypasses Row Level Security)
# Required by API routes for ingestion and server-side data reads.
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
