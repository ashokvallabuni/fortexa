# Supabase Project Configuration
# Use the same project in local development and your hosting provider.
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Client / Public Keys (Anon / Publishable)
# Used by the browser client and authenticated server requests.
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Frontend / Vite Client-Side Environment Variables
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Python FastAPI analytics service.
# Local: http://localhost:8000
# Vercel: https://<render-service>.onrender.com
VITE_API_URL="http://localhost:8000"

# Backend dataset configuration. Render uses the mounted disk path.
CIC_DATASET_DIR="/data/CIC-IDS2018"
CIC_CACHE_DIR="/data/cache"
CIC_CHUNK_SIZE="50000"
CIC_TRAINING_ROWS="200000"
CIC_CACHE_TTL_SECONDS="3600"
FRONTEND_URL="https://net-state-loom.vercel.app"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://net-state-loom.vercel.app"

# Supabase Server / Admin Role Key (Bypasses Row Level Security)
# Required by API routes for ingestion and server-side data reads.
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
